{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/warn-file-length.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check-file-length.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/autofix-comment-quality.js"
          }
        ]
      }
    ]
  }
}
